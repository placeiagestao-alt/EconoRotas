# Copie para .env.android-production antes de compilar o APK de producao.
# Esta URL deve ser um backend publico HTTPS, acessivel fora da sua rede local.
# Exemplo gratis Vercel: https://econo-rotas.vercel.app
VITE_API_BASE_URL=https://econo-rotas.vercel.app
VITE_ENABLE_DEV_LOGIN=false
VITE_PRIVACY_POLICY_URL=https://seu-dominio.com/politica-de-privacidade

# Opcional: apenas se tambem quiser manter OAuth Manus.
# VITE_OAUTH_PORTAL_URL=https://seu-servidor-oauth.com
# VITE_APP_ID=seu_app_id
