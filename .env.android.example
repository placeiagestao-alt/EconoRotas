# Ambiente Android local, usado por:
# pnpm run android:sync
#
# Em emulador Android, 10.0.2.2 aponta para o localhost do computador.
# Em celular fisico, use o IP da maquina na rede, por exemplo http://192.168.0.10:3000
VITE_API_BASE_URL=http://10.0.2.2:3000
VITE_ENABLE_DEV_LOGIN=true
VITE_PRIVACY_POLICY_URL=https://seu-dominio.com/politica-de-privacidade

# Para APK sem depender do Windows/PC local, use .env.android-production
# e rode: pnpm run android:sync:prod
