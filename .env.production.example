# Copie para .env.production no servidor Linux/Docker.
NODE_ENV=production
PORT=3000
HOST_PORT=3000

# Banco MySQL gerenciado usado pelo backend na Vercel.
# Exemplo Aiven: mysql://avnadmin:SENHA@host.aivencloud.com:16930/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://avnadmin:troque_a_senha@seu-mysql-gerenciado.example.com:3306/defaultdb?ssl-mode=REQUIRED
# Use true quando o MySQL externo exigir TLS/SSL. Aiven exige SSL.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Cole o certificado CA do provedor em DATABASE_SSL_CA no Vercel.
# Para execucao local de migrations, use DATABASE_SSL_CA_PATH=.tmp/aiven-ca.pem.
DATABASE_SSL_CA=
DATABASE_SSL_CA_PATH=
# Vercel escala criando instancias; limite baixo evita estourar conexoes do MySQL.
DB_CONNECTION_LIMIT=5
DB_QUEUE_LIMIT=0
# Evita que deprecation warning de dependencia seja registrado como erro pela Vercel.
SUPPRESS_NODE_DEPRECATION_WARNINGS=true
# Use true para bloquear fallback e garantir MySQL persistente em producao.
REQUIRE_MANAGED_DATABASE=true
CAPACITY_TARGET_USERS=50
# No plano Hobby, a Vercel chama /api/monitor/ping 1x ao dia.
# Para monitorar a cada 5 minutos, use um monitor externo gratuito nesse endpoint.
# Mantenha false em producao real. Use true apenas para demo sem persistencia.
ALLOW_EPHEMERAL_DB=false

# Vercel sem MySQL gerenciado:
# crie um Upstash Redis pelo Vercel Marketplace e use as variaveis abaixo.
# Com estas variaveis, o fallback JSON passa a ser persistente no Redis.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# ou:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# FALLBACK_DB_KEY=econorotas:fallback-db:v1

# Mantenha true em producao. Use false apenas para diagnostico local de certificado Docker.
NPM_CONFIG_STRICT_SSL=true

# Use uma chave longa e aleatoria. Minimo validado: 32 caracteres.
JWT_SECRET=troque_por_uma_chave_grande_com_mais_de_32_caracteres

# Criptografa tokens de integracoes por usuario. Se vazio, usa JWT_SECRET.
INTEGRATION_CREDENTIALS_SECRET=troque_por_outra_chave_grande_com_mais_de_32_caracteres

# Admin do painel operacional. Configure todos os administradores aqui.
ADMIN_EMAILS=andersongiacomini77@gmail.com,placeiagestao@gmail.com
OWNER_EMAIL=andersongiacomini77@gmail.com

# Dominio publico sem https://. Para dominio gratis, use DuckDNS:
# exemplo: econorotas-anderson.duckdns.org
PUBLIC_DOMAIN=econorotas-seunome.duckdns.org
TLS_CONTACT_EMAIL=admin@econorotas-seunome.duckdns.org

# URL publica do backend/app. Exemplo: https://econorotas-seunome.duckdns.org
PUBLIC_APP_URL=https://econorotas-seunome.duckdns.org

# Origens extras permitidas por CORS, separadas por virgula.
# Para Android Capacitor, http://localhost e capacitor://localhost sao usados pelo WebView.
ALLOWED_ORIGINS=https://econorotas-seunome.duckdns.org,http://localhost,https://localhost,capacitor://localhost,ionic://localhost

# DuckDNS: dominio sem .duckdns.org e token da sua conta.
DUCKDNS_DOMAIN=econorotas-seunome
DUCKDNS_TOKEN=cole_o_token_duckdns_aqui
DUCKDNS_LOG=./duckdns.log

# OAuth Manus opcional. O login proprio por e-mail/senha ja funciona sem estes campos.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Google OAuth direto para o login "Entrar com Google".
# Configure no Google Cloud com redirect:
# https://econo-rotas.vercel.app/api/oauth/callback
AUTH_LOGIN_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
VITE_PRIVACY_POLICY_URL=

# Proxies/servicos opcionais.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
NOMINATIM_CONTACT_EMAIL=suporte@seu-dominio.com
# Intervalo minimo entre chamadas externas ao Nominatim por instancia.
# Para teste com varios usuarios, mantenha cache ligado e evite zerar este valor.
GEOCODING_EXTERNAL_MIN_INTERVAL_MS=1100
GEOCODING_RATE_LIMIT_PER_MINUTE=60
GEOCODING_PROVIDER_COOLDOWN_MS=120000

# OSRM / motor de rotas por ruas.
# Producao real deve usar instancia propria. O servico publico router.project-osrm.org
# nao deve ser usado como dependencia operacional.
OSRM_ENABLED=true
OSRM_BASE_URL=https://osrm.econorotas.com
OSRM_REQUEST_TIMEOUT_MS=8000
OSRM_HEALTH_TIMEOUT_MS=3000
OSRM_MAX_TABLE_NODES=100
OSRM_REQUIRED=true
OSRM_REQUIRED_MIN_STOPS=101

# Escalabilidade da otimizacao.
# Acima de MAX_SYNC_STOPS, a rota nao roda dentro da requisicao HTTP.
# Configure BULLMQ_REDIS_URL/REDIS_URL e rode pnpm worker:optimization em um worker externo.
# Limite comercial por rota. O usuario pode criar multiplas rotas; o limite nao e acumulado por usuario.
MAX_ROUTE_STOPS=160
MAX_SYNC_STOPS=160
MAX_GEOGRAPHIC_FALLBACK_STOPS=160
# No beta de um usuario, false evita conexoes/custos Redis e mantem o modo sincrono.
# Para escalar, altere para true junto com Redis e workers externos ativos.
OPTIMIZATION_QUEUE_ENABLED=false
# Preferir rediss:// com TLS habilitado no Redis gerenciado.
# Redis/BullMQ deve usar maxmemory-policy=noeviction no provedor gerenciado.
# Se KV_URL estiver presente com politica noeviction, ele e preferido sobre REDIS_URL.
BULLMQ_REDIS_URL=

# Disaster Recovery diario.
# RESTORE_TEST_DATABASE_URL deve apontar para banco MySQL descartavel, nunca para o banco real.
RESTORE_TEST_DATABASE_URL=mysql://usuario:senha@host:3306/econorotas_restore_test?ssl-mode=REQUIRED
# Alternativa: se o banco descartavel estiver no mesmo servidor de DATABASE_URL, use apenas o nome.
DR_RESTORE_DATABASE_NAME=
DR_RESTORE_CONFIRM_DATABASE=econorotas_restore_test
DR_BACKUP_DIR=backups/disaster-recovery
DR_BACKUP_BATCH_SIZE=1000
DR_DB_CONNECTION_LIMIT=2

# iMile / Rider Delivery.
# O app Android/iOS Rider Delivery e o app operacional da iMile para receber pedidos,
# registrar entregas concluídas e enviar problemas de baixa.
# Configure aqui o endpoint/token capturado ou fornecido pela iMile. Nunca coloque
# estes valores no front-end.
IMILE_API_BASE_URL=https://driverapp.imile.com
IMILE_FALLBACK_BASE_URLS=https://driverapp-zen.imile.com,https://driverapp-cf.imile.com,https://driverapp-sgaws.imile.com
IMILE_DELIVERIES_PATH=/lm/express/driver/v1/driver/delivery/delivery/queryDeliveryListV2
IMILE_CUSTOMER_ID=
IMILE_SIGN=
IMILE_AUTH_HEADER=Authorization
IMILE_AUTH_TOKEN=
IMILE_COUNTRY=BRA
IMILE_LANG=pt-BR
IMILE_RESOURCE_CODE=BRA
IMILE_TIMEZONE=America/Sao_Paulo
IMILE_HUB_CODE=
IMILE_APP_VERSION=2.2.78
IMILE_SOURCE_NAME=REDeliveryApp

# Nunca use true em producao. O servidor bloqueia isso.
VITE_ENABLE_DEV_LOGIN=false

# Android update (APK distribuido fora da Play Store)
# O app Android consulta /api/app-update/android.
ANDROID_UPDATE_LATEST_VERSION=
ANDROID_UPDATE_APK_URL=
ANDROID_UPDATE_REQUIRED=false
ANDROID_MINIMUM_SUPPORTED_VERSION=
ANDROID_UPDATE_MESSAGE=
ANDROID_UPDATE_PUBLISHED_AT=

# Opcional: versao usada pelo app Android para comparar updates.
VITE_ANDROID_APP_VERSION=1.0.8
