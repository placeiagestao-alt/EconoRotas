{
  "name": "econorotas",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build:api": "esbuild server/_vercel/index.ts --platform=node --bundle --format=esm --outfile=api/index.js --packages=external",
    "build": "vite build && esbuild server/_core/start.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "build:vercel": "pnpm run build:api && pnpm run build",
    "build:vercel:prod": "pnpm run check:production && pnpm run build:vercel",
    "start": "NODE_ENV=production node dist/index.js",
    "worker:optimization": "tsx server/optimizationWorker.ts",
    "check": "tsc --noEmit",
    "check:production": "node scripts/check-production.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-managed-mysql.mjs",
    "build:android": "node scripts/android-build.mjs android",
    "build:android:prod": "node scripts/android-build.mjs android-production",
    "android:add": "cap add android",
    "android:copy": "node scripts/android-build.mjs android copy",
    "android:copy:prod": "node scripts/android-build.mjs android-production copy",
    "android:sync": "node scripts/android-build.mjs android sync",
    "android:sync:prod": "node scripts/android-build.mjs android-production sync",
    "android:usb": "node scripts/android-usb-reverse.mjs",
    "android:open": "cap open android",
    "imile:capture": "node scripts/capture-imile-screen.mjs",
    "imile:capture:upload": "node scripts/capture-imile-screen.mjs --upload-url=https://econo-rotas.vercel.app/api/imile/capture/latest"
  },
  "dependencies": {
