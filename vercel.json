{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build:vercel:prod",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile --config.only-built-dependencies=esbuild",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/monitor/ping",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/downloads/econorotas-v1.0.0.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"econorotas-v1.0.0.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=api&path=:path*"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api?__route=manus-storage&path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
